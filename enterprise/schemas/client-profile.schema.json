{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-seo.local/schemas/client-profile.schema.json",
  "title": "Web-SEO client profile",
  "type": "object",
  "required": [
    "schema_version",
    "slug",
    "name",
    "domains",
    "primary_domain",
    "industry",
    "data_retention_days",
    "budgets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "primary_domain": {
      "type": "string"
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "markets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "country",
          "language"
        ],
        "properties": {
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "language": {
            "type": "string"
          }
        }
      }
    },
    "industry": {
      "enum": [
        "saas",
        "ecommerce",
        "local",
        "publisher",
        "agency",
        "other"
      ]
    },
    "brand": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "primary_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "logo_url": {
          "type": "string"
        }
      }
    },
    "contacts": {
      "type": "object",
      "properties": {
        "owner_alias": {
          "type": "string"
        },
        "approver_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
          }
        }
      }
    },
    "action_overrides": {
      "type": "object",
      "description": "May only tighten org policy",
      "propertyNames": {
        "enum": [
          "read_only_analysis",
          "paid_api_call",
          "google_api_write",
          "indexnow_submit",
          "account_registration",
          "account_login",
          "directory_submission",
          "outreach_email",
          "image_host_upload",
          "file_write_client_site",
          "content_publish",
          "payment",
          "reciprocal_link",
          "captcha_bypass",
          "mass_outreach"
        ]
      },
      "additionalProperties": {
        "enum": [
          "allow",
          "require_approval",
          "deny"
        ]
      }
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budgets": {
      "type": "object",
      "properties": {
        "monthly_api_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "data_retention_days": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "archived"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
